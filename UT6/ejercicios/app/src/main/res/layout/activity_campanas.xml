<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="#F4ECE1"> <!-- Color crema simulando pergamino antiguo -->

    <TextView
            android:id="@+id/tvTituloAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Los Campanas "
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="32dp"/>

    <Button
            android:id="@+id/btnPlayAudio"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Tocar Alarma"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#8E44AD"/> <!-- Color púrpura noble éflico -->

    <Button
            android:id="@+id/btnPauseAudio"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Detener Alarma"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#7561"/>

    <Button
            android:id="@+id/btnRestartAudio"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Reiniciar Alarma"
            android:backgroundTint="#7F8C8D"/>

</LinearLayout>