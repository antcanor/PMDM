<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Título del Ejercicio de la UT6 -->
    <TextView
            android:id="@+id/tvSubtituloVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incrustación Multimedia (WebView)\nEl Palantír de Saruman"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@id/webViewPalantir"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor Web Adaptado en Vertical 📱 -->
    <WebView
            android:id="@+id/webViewPalantir"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:background="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>