<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:background="#0C0C0F"
        android:gravity="center_horizontal">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔️ FORJA DE BATALLONES (SQLITE)"
            android:textColor="#F1C40F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"/>

    <EditText
            android:id="@+id/etNombreBatallon"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nombre del Batallón (ej: Arqueros de Ithilien)"
            android:textColor="#FFFFFF"
            android:textColorHint="#444449"
            android:backgroundTint="#F1C40F"
            android:inputType="text"/>

    <EditText
            android:id="@+id/etNumeroSoldados"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Cantidad de efectivos"
            android:textColor="#FFFFFF"
            android:textColorHint="#444449"
            android:backgroundTint="#F1C40F"
            android:inputType="number"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

    <!-- Controles de Comando -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

        <Button
                android:id="@+id/btnInsertarBD"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Reclutar"
                android:backgroundTint="#27AE60"
                android:textColor="#FFFFFF"
                android:layout_marginRight="8dp"/>

        <Button
                android:id="@+id/btnEliminarBD"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Licenciar"
                android:backgroundTint="#C0392B"
                android:textColor="#FFFFFF"/>
    </LinearLayout>

    <Button
            android:id="@+id/btnConsultarBD"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Pasar Revista General"
            android:backgroundTint="#2980B9"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>
    <!-- Consola de Salida del Censo -->
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#161A23"
            android:padding="12dp">

        <TextView
                android:id="@+id/tvConsolaBD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consola del Censo lista para reporte..."
                android:textColor="#2ECC71"
                android:fontFamily="monospace"
                android:textSize="12sp"/>
    </ScrollView>

</LinearLayout>