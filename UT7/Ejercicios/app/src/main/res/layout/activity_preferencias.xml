<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp"
        android:background="#121214">
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜 REGISTRO DE PUESTO DE CONTROL"
            android:textColor="#A29BFE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

    <EditText
            android:id="@+id/etNombreGuardia"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nombre del Centinela"
            android:textColor="#FFFFFF"
            android:textColorHint="#75757A"
            android:backgroundTint="#6C5CE7"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"/>

    <Button
            android:id="@+id/btnGuardarPref"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:text="Registrar en Preferencias"
            android:backgroundTint="#6C5CE7"
            android:layout_marginBottom="32dp"/>

    <TextView
            android:id="@+id/tvUltimoRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Último centinela guardado: Ninguno"
            android:textColor="#9E9E9E"
            android:textSize="14sp"/>

</LinearLayout>