<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <ImageView
        android:id="@+id/ivAnillo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="@string/anillo"
        android:src="@drawable/anillo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivGondor"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/gondor"
        android:contentDescription="@string/gondor"
        app:layout_constraintCircle="@id/ivAnillo"
        app:layout_constraintCircleRadius="140dp"
        app:layout_constraintCircleAngle="0" />

    <ImageView
        android:id="@+id/ivRohan"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/rohan"
        android:contentDescription="@string/rohan"
        app:layout_constraintCircle="@id/ivAnillo"
        app:layout_constraintCircleRadius="140dp"
        app:layout_constraintCircleAngle="120"/>

    <ImageView
        android:id="@+id/ivMordor"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/mordor"
        android:contentDescription="@string/mordor"
        app:layout_constraintCircle="@id/ivAnillo"
        app:layout_constraintCircleRadius="140dp"
        app:layout_constraintCircleAngle="240" />

    <Button
        android:id="@+id/btnSeleccionar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seleccionar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>